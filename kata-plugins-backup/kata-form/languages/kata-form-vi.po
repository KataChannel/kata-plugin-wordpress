# Settings page
msgid "Kata Form Settings"
msgstr "Cài Đặt Kata Form"

msgid "Data Collection"
msgstr "Thu Thập Dữ Liệu"

msgid "Save IP Address"
msgstr "Lưu Địa Chỉ IP"

msgid "Store visitor IP addresses with form submissions"
msgstr "Lưu trữ địa chỉ IP của người gửi form"

msgid "Enable this to track the IP address of form submitters for security and analytics."
msgstr "Bật tùy chọn này để theo dõi địa chỉ IP của người gửi form cho mục đích bảo mật và phân tích."

msgid "Save User Agent"
msgstr "Lưu User Agent"

