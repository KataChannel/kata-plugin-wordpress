msgstr "Lưu trữ thông tin trình duyệt user agent"

msgid "This helps identify the browser and device used for submissions."
msgstr "Điều này giúp xác định trình duyệt và thiết bị được sử dụng để gửi form."

msgid "Save Referrer"
msgstr "Lưu Referrer"

msgid "Store the referring page URL"
msgstr "Lưu trữ URL trang giới thiệu"

msgid "Track which pages or external sites visitors came from before submitting the form."
msgstr "Theo dõi khách truy cập đến từ trang nào hoặc trang web bên ngoài nào trước khi gửi form."

msgid "Notifications"
msgstr "Thông Báo"

