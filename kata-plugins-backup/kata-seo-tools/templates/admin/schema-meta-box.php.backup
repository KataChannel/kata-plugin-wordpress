<div class="kata-meta-box kata-schema-meta-box">
    <div class="kata-field">
        <label for="kata_seo_schema_enabled">
            <input type="checkbox" 
                   id="kata_seo_schema_enabled" 
                   name="kata_seo_schema_enabled" 
                   value="1" 
                   <?php checked($schema_enabled, true); ?>>
            Enable Schema Markup for this post
        </label>
    </div>

    <div class="kata-field">
        <label for="kata_seo_schema_type">Schema Type:</label>
        <select id="kata_seo_schema_type" name="kata_seo_schema_type" class="widefat">
            <option value="Article" <?php selected($schema_type, 'Article'); ?>>Article</option>
            <option value="BlogPosting" <?php selected($schema_type, 'BlogPosting'); ?>>Blog Posting</option>
            <option value="NewsArticle" <?php selected($schema_type, 'NewsArticle'); ?>>News Article</option>
            <option value="Product" <?php selected($schema_type, 'Product'); ?>>Product</option>
            <option value="Review" <?php selected($schema_type, 'Review'); ?>>Review</option>
            <option value="Recipe" <?php selected($schema_type, 'Recipe'); ?>>Recipe</option>
            <option value="Event" <?php selected($schema_type, 'Event'); ?>>Event</option>
            <option value="VideoObject" <?php selected($schema_type, 'VideoObject'); ?>>Video</option>
            <option value="Course" <?php selected($schema_type, 'Course'); ?>>Course</option>
            <option value="FAQPage" <?php selected($schema_type, 'FAQPage'); ?>>FAQ Page</option>
        </select>
        <p class="description">Choose the Schema.org type that best describes this content.</p>
    </div>

    <?php if ($schema_type === 'Product') : ?>
    <div class="kata-field kata-product-fields">
        <h4>Product Details</h4>
        
        <label for="kata_seo_product_price">Price:</label>
        <input type="text" 
               id="kata_seo_product_price" 
               name="kata_seo_product_price" 
               value="<?php echo esc_attr(get_post_meta($post->ID, '_kata_seo_product_price', true)); ?>" 
               class="widefat">
        
        <label for="kata_seo_product_currency">Currency:</label>
        <input type="text" 
               id="kata_seo_product_currency" 
               name="kata_seo_product_currency" 
               value="<?php echo esc_attr(get_post_meta($post->ID, '_kata_seo_product_currency', true) ?: 'USD'); ?>" 
               class="widefat">
        
        <label for="kata_seo_product_brand">Brand:</label>
        <input type="text" 
               id="kata_seo_product_brand" 
               name="kata_seo_product_brand" 
               value="<?php echo esc_attr(get_post_meta($post->ID, '_kata_seo_product_brand', true)); ?>" 
               class="widefat">
    </div>
    <?php endif; ?>

    <?php if ($schema_type === 'Review') : ?>
    <div class="kata-field kata-review-fields">
        <h4>Review Details</h4>
        
        <label for="kata_seo_review_rating">Rating (1-5):</label>
        <input type="number" 
               id="kata_seo_review_rating" 
               name="kata_seo_review_rating" 
               min="1" 
               max="5" 
               step="0.1"
               value="<?php echo esc_attr(get_post_meta($post->ID, '_kata_seo_review_rating', true)); ?>" 
               class="widefat">
        
        <label for="kata_seo_review_item">Item Reviewed:</label>
        <input type="text" 
               id="kata_seo_review_item" 
               name="kata_seo_review_item" 
               value="<?php echo esc_attr(get_post_meta($post->ID, '_kata_seo_review_item', true)); ?>" 
               class="widefat">
    </div>
    <?php endif; ?>

    <?php if ($schema_type === 'Event') : ?>
    <div class="kata-field kata-event-fields">
        <h4>Event Details</h4>
        
        <label for="kata_seo_event_start">Start Date & Time:</label>
        <input type="datetime-local" 
               id="kata_seo_event_start" 
               name="kata_seo_event_start" 
               value="<?php echo esc_attr(get_post_meta($post->ID, '_kata_seo_event_start', true)); ?>" 
               class="widefat">
        
        <label for="kata_seo_event_end">End Date & Time:</label>
        <input type="datetime-local" 
               id="kata_seo_event_end" 
               name="kata_seo_event_end" 
               value="<?php echo esc_attr(get_post_meta($post->ID, '_kata_seo_event_end', true)); ?>" 
               class="widefat">
        
        <label for="kata_seo_event_location">Location:</label>
        <input type="text" 
               id="kata_seo_event_location" 
               name="kata_seo_event_location" 
               value="<?php echo esc_attr(get_post_meta($post->ID, '_kata_seo_event_location', true)); ?>" 
               class="widefat">
    </div>
    <?php endif; ?>

    <div class="kata-field">
        <p class="description">
            <strong>Preview:</strong> Schema markup will be automatically generated based on your post content and the selected type.
            You can verify the markup using <a href="https://search.google.com/test/rich-results" target="_blank">Google's Rich Results Test</a>.
        </p>
    </div>
</div>

<style>
.kata-meta-box {
    padding: 10px 0;
}
.kata-meta-box .kata-field {
    margin-bottom: 15px;
}
.kata-meta-box label {
    display: block;
    font-weight: 600;
    margin-bottom: 5px;
}
.kata-meta-box .description {
    font-style: italic;
    color: #666;
    margin-top: 5px;
}
.kata-meta-box h4 {
    margin: 20px 0 10px;
    padding-bottom: 5px;
    border-bottom: 1px solid #ddd;
}
</style>

<script>
jQuery(document).ready(function($) {
    // Show/hide conditional fields based on schema type
    $('#kata_seo_schema_type').on('change', function() {
        var type = $(this).val();
        
        // Hide all conditional fields
        $('.kata-product-fields, .kata-review-fields, .kata-event-fields').hide();
        
        // Show relevant fields
        if (type === 'Product') {
            $('.kata-product-fields').show();
        } else if (type === 'Review') {
            $('.kata-review-fields').show();
        } else if (type === 'Event') {
            $('.kata-event-fields').show();
        }
    }).trigger('change');
});
</script>
